{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ResumeScan;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "BasicAuthentication": {
    "Username": "CHANGE_ME",
    "Password": "CHANGE_ME"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
